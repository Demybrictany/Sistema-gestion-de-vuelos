# ============================================================
# Configuración de entorno
# Copia este archivo como .env y reemplaza los valores.
# NUNCA subas el archivo .env al repositorio.
# ============================================================

# --- Opción 1: Neon / PostgreSQL en la nube (recomendado) ---
# Cadena de conexión que entrega Neon (Project → Connect).
DATABASE_URL=postgresql://usuario:password@ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_SSL=true

# --- Opción 2: PostgreSQL local ---
# Si DATABASE_URL está definida, estas variables se ignoran.
# DB_NAME=aeropuerto_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_SSL=false

# --- Servidor ---
PORT=3000
# Orígenes permitidos para el frontend/panel (separados por coma).
# En desarrollo con el proxy de Vite puedes dejarlo en *.
CORS_ORIGIN=*
# URL pública del frontend cuando se despliega aparte del backend.
# CLIENT_URL=http://localhost:5173

# --- Autenticación ---
# Genera un valor aleatorio, por ejemplo:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# --- Mensajería asíncrona (RabbitMQ / CloudAMQP) ---
# URL AMQP del broker. Si se omite, la API funciona igual y el worker
# de notificaciones no arranca.
# CloudAMQP: panel de la instancia → "AMQP URL".
RABBITMQ_URL=amqps://usuario:password@host/vhost
RABBITMQ_EXCHANGE=sistema.vuelos
RABBITMQ_EXCHANGE_FALLIDAS=sistema.vuelos.fallidas
RABBITMQ_QUEUE=notificaciones.pasajeros
RABBITMQ_QUEUE_FALLIDAS=notificaciones.fallidas
RABBITMQ_QUEUE_REINTENTOS=notificaciones.reintentos
RABBITMQ_MAX_REINTENTOS=3
RABBITMQ_TTL_REINTENTO_MS=5000
RABBITMQ_PREFETCH=10

# --- Entrega de correo ---
# simulado: no envía correo real, solo registra la entrega en la BD.
# smtp: envía por el servidor configurado (Ethereal, Mailtrap, etc.).
CORREO_MODO=simulado
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Sistema de Vuelos AICM <no-reply@example.com>

# --- Pruebas de integración ---
# Credenciales del administrador que usan los scripts de prueba. Si cambias
# la contraseña del seed, define ADMIN_PASSWORD para que sigan funcionando.
# ADMIN_USUARIO=admin
# ADMIN_PASSWORD=Admin123!
# SECRETARIO_USUARIO=secretario
# SECRETARIO_PASSWORD=Secretario123!
# PASAJERO_USUARIO=carlos
# PASAJERO_PASSWORD=Pasajero123!
# API_URL=http://localhost:3000

# --- Producción (Render) ---
# No se copian a .env: se configuran en el panel de Render (render.yaml).
# En producción la API y el worker arrancan juntos con `npm run start:prod`.
# NODE_ENV=production
# TZ=America/Mexico_City
# WORKER_REINTENTO_MS=5000
# La guía completa está en docs/DESPLIEGUE.md.
